{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "warehouse-tools-app",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-31",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "warehouse-inventory",
      "database_id": "687d1a4d-d154-4bbd-ab68-8f46603f396a"
    }
  ]
}